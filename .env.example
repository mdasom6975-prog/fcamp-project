# Vercel 프로젝트의 Environment Variables 에 넣는다(로컬 개발은 backend/.env). 값은 저장소에 올리지 않는다.

# --- Supabase ---
# Postgres 연결 문자열. 서버리스에서는 풀러(Transaction mode, 포트 6543)의 주소를 쓴다.
DATABASE_URL=postgresql://postgres.<프로젝트ref>:<DB비밀번호>@aws-0-<리전>.pooler.supabase.com:6543/postgres
# Storage: Project Settings → API 의 URL 과 service_role 키(서버에서만 쓰고 프론트에는 절대 넣지 않는다)
SUPABASE_URL=https://<프로젝트ref>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=brand-studio

# --- 모델 API ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- 시연 운영값 ---
IMAGE_DAILY_LIMIT=50
APP_PASSWORD=
APP_USER=demo
APP_PUBLIC=1
